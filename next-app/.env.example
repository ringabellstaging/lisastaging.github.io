# Set only after choosing and verifying the production domain. Blank means noindex.
SITE_URL=

# Verify oaktime.ca in Resend before using this From address.
RESEND_API_KEY=
INQUIRY_FROM=Oaktime Staging <info@oaktime.ca>
# Private forwarding destination; never taken from a form field.
INQUIRY_TO=info@oaktime.ca
# Enable the requested customer acknowledgement (in the chosen website language).
# Omitted/false means forwarding only; saved inquiries retain their original choice.
INQUIRY_SEND_CONFIRMATION=true

# Durable inquiry records, shared rate limiting and retry queue (30-day retention).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Separate 32-byte random key, base64 encoded, stored only in Vercel Production.
# Required: inquiries are encrypted before storage. Keep stable for existing records.
INQUIRY_ENCRYPTION_KEY=

# Random secret for the Vercel retry cron. Set in Production.
CRON_SECRET=
