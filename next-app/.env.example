# Set only after choosing and verifying the production domain. Blank means noindex.
SITE_URL=

# Verified Oaktime sending domain; never a gmail.com From address.
RESEND_API_KEY=
INQUIRY_FROM=

# Durable inquiry records, shared rate limiting and retry queue (30-day retention).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random secret for the Vercel retry cron. Set in Production.
CRON_SECRET=
